# =============================================================================
# AETCG Platform Environment Configuration
# =============================================================================
# Copy this file to .env and customize values for your environment
# =============================================================================

# Application Environment
# Allowed values: development, staging, production
APP_ENV=development

# API Service Configuration
# Port on which the API service will listen
API_PORT=8000

# Redis Configuration (for queue broker and caching)
# Hostname or IP address of the Redis server
REDIS_HOST=queue_broker
# Port on which Redis is listening
REDIS_PORT=6379

# External Compliance API Configuration
# URL of the external compliance validation service
EXTERNAL_COMPLIANCE_API_URL=https://api.mockcompliance.org/v1/validate
# Timeout for external API calls in seconds (must be > 0)
EXTERNAL_API_TIMEOUT_SEC=5.0

# LLM Service Configuration
# Base URL for the LLM service API
LLM_ENDPOINT_URL=https://studio.bearcatgpt.uc.edu/api/v1/
# Access token for authenticating with the LLM service
# WARNING: In production, this must be set to a valid token
LLM_ACCESS_TOKEN=your_llm_access_token_here

# Security Settings
# Maximum API requests allowed per minute per IP address (must be > 0)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Browser origins allowed to call the API (comma-separated). Never use "*" with
# credentialed requests; if "*" is set, credentials are disabled automatically.
CORS_ALLOWED_ORIGINS=http://localhost:8000
# Token required for supervisor approval endpoint
# WARNING: In production, this must be changed from the default
SUPERVISOR_TOKEN=SECURE_GOVERNANCE_TOKEN_XYZ

# Metrics Settings
# Enable Prometheus metrics collection and exposure
METRICS_ENABLED=true
# Port for metrics endpoint (same as API port in this implementation)
METRICS_PORT=8000
# Path for metrics endpoint
METRICS_PATH=/metrics